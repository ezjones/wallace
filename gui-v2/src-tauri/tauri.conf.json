{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallace",
  "version": "0.1.0",
  "identifier": "dev.resolveaacfix.gui",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash scripts/stage-resources.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Wallace",
        "width": 840,
        "height": 760,
        "minWidth": 640,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../bundle-staging/payload.tar.gz": "payload.tar.gz"
    }
  }
}
